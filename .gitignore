# =============================================================================
# Monorepo .gitignore
# Stack: Next.js + TypeScript (apps/web), FastAPI + Python (apps/api),
#        Supabase (auth/DB), Vercel (deploy), macOS
# =============================================================================

# ---- Environment & secrets ----
.env
.env.local
.env.*.local
.env.backup*

# ---- OS files ----
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# ---- IDE / editor ----
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ---- Node.js ----
node_modules/
npm-debug.log*
npm-error.log*

# ---- Next.js (apps/web) ----
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ---- Python / FastAPI (apps/api) ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Supabase CLI ----
supabase/.temp/

# ---- Vercel ----
.vercel

# ---- Logs ----
logs/
*.log

# ---- Temp files ----
*.tmp
*.bak
.cache/

# ---- Root lockfile (real lockfile is apps/web/package-lock.json) ----
/package-lock.json

# ---- AI / agent tool scratch dirs ----
.somni/
.superpowers/
