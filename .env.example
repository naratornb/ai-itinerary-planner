# Copy to .env at the repo root and fill from your Supabase Cloud project (Settings → API).
# This is the ONLY env file: apps/api loads it directly (app/core.py) and apps/web loads it
# via next.config.ts — no per-app copies. The Bruno smoke collection reads it through a
# symlink; on a fresh clone create it once:
#   ln -s ../../../.env apps/test/fc-itinerary-planner-test-collection/.env
# Local-only: CI and Vercel builds never see this file — they take the same keys as
# environment variables (CI injects dummies in ci.yml; deploys use Vercel project settings).
# See "Setup" in the root README for which keys each pipeline needs.

# Web (browser-exposed)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:5001

# API (server-only — never expose the service role key)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Smoke tests (Bruno collection — apps/test/fc-itinerary-planner-test-collection)
# A real Supabase Auth user created for smoke runs — the seeded creator rows are
# DB-only and cannot log in, so you need an actual account here.
SMOKE_EMAIL=smoke@example.com
SMOKE_PASSWORD=change-me
# A real Supabase Auth user whose profiles.role is 'admin'.
# Used by 05-approvals. Locally the seeded admin account works.
SMOKE_ADMIN_EMAIL=admin@seed.local
SMOKE_ADMIN_PASSWORD=change-me
# Supabase public anon key (same project as above).
SUPABASE_ANON_KEY=your-anon-key
# Smoke-run targets.
# Deployed API: https://ai-itinerary-planner-api-byteme-projects.vercel.app
# Use the project's production URL, never a hash-suffixed deployment URL
# (e.g. ...-qr7jvh1qx-...) — those are immutable snapshots pinned to the code
# and env vars they were built with, so they never pick up new deployments.
HOST_API_URL=http://localhost:8000
HOST_APP_URL=http://localhost:3000
