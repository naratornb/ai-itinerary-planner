# Copy to .env and fill from your Supabase Cloud project (Settings → API).
# apps/web reads this via the apps/web/.env.local symlink; apps/api loads it directly.

# Web (browser-exposed)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:5001

# API (server-only — never expose the service role key)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
